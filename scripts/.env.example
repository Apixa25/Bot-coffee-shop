# E2E Test Environment Variables
# Copy this file to .env.test and fill in your local Supabase credentials
# DO NOT commit .env.test or use production values!

# Edge Functions URL (local Supabase)
TEST_API_URL=http://localhost:54321/functions/v1

# Supabase Project URL (local)
TEST_SUPABASE_URL=http://localhost:54321

# Supabase Service Role Key (local only!)
# Get from: supabase status | grep service_role
TEST_SUPABASE_SERVICE_KEY=your-local-service-role-key-here

# Test Bot API Keys (generate with: openssl rand -hex 32)
TEST_BOT_1_KEY=your-test-bot-1-api-key-here
TEST_BOT_2_KEY=your-test-bot-2-api-key-here

# IMPORTANT: These are TEST credentials only!
# - Never use production URLs or keys
# - The script will refuse to run against production
# - All URLs must be localhost
